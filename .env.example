# Токен вашего Telegram-бота от @BotFather
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Путь к файлу базы данных SQLite
DATABASE_PATH=./bot.db

# Время ожидания подтверждения заказа заведением (в минутах)
ORDER_EXPIRY_MINUTES=15

# Telegram ID групп заведений для приёма заказов (опционально для сида)
PIZZERIA_CHAT_ID=-1001234567890
VARKA_CHAT_ID=-1001234567891
BULOCHKI_CHAT_ID=-1001234567892

# Telegram ID сотрудника для быстрого добавления в place_staff через npm run seed
STAFF_TELEGRAM_ID=123456789

# Реквизиты для поддержки проекта
DONATE_CARD=4916 0000 0000 0000
DONATE_PHONE=+375 29 000-00-00
DONATE_RECIPIENT=Руслан Р.
CREATOR_USERNAME=RuslanR93

# Лог-бот для ошибок: создайте отдельного бота в @BotFather и нажмите у него /start
LOG_BOT_TOKEN=
# Куда слать отчёты (по умолчанию — ADMIN_IDS), можно несколько через запятую
LOG_CHAT_ID=
# Подпись бота в отчётах, например ПРОД или DEV
BOT_LABEL=
# Одинаковая ошибка — не чаще раза в N минут (со счётчиком повторов)
ERROR_REPORT_WINDOW_MINUTES=10

# Предзаказы в кафе (каталог, корзина, пульт кухни): true — включить
FEATURE_PREORDERS=false
